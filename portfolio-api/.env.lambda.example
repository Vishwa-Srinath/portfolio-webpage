# Copy to .env.lambda and replace every placeholder before first deployment.
# This file contains secrets once populated and is ignored by git.

DEBUG=false
ALLOWED_ORIGINS=https://your-project.vercel.app,http://localhost:3000

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

# Resend is optional. Leave blank to store messages without email notifications.
RESEND_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@yourdomain.com
CONTACT_NOTIFICATION_EMAIL=you@yourdomain.com

RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=3600
SENTRY_DSN=
